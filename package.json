{
  "name": "espifam-site",
  "private": true,
  "version": "0.2.0",
  "description": "Static family-creators hub at espifam.com",
  "scripts": {
    "build:html": "node scripts/build.mjs",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build": "npm run build:html && npm run build:css",
    "dev": "npm run build:html && tailwindcss -i src/styles/input.css -o public/styles.css --watch",
    "serve": "docker run --rm -p 8085:80 -v \"$PWD/public:/usr/share/nginx/html:ro\" nginx",
    "og": "node scripts/gen-og.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
