{
  "name": "espifam-site",
  "private": true,
  "version": "0.2.0",
  "description": "Static family-creators hub at espifam.com",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build:copy": "node scripts/copy-src.mjs",
    "build": "rm -rf public && mkdir -p public && npm run build:css && npm run build:copy",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
