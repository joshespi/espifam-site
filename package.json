{
  "name": "espifam-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static family-creators hub at espifam.com",
  "scripts": {
    "dev": "tailwindcss -i src/styles/input.css -o src/styles/output.css --watch",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build:copy": "rsync -a --delete --exclude='styles' --exclude='styles.css' src/ public/",
    "build": "rm -rf public && mkdir -p public && npm run build:copy && npm run build:css",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
